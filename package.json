{
  "name": "dial-slider",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "bun run --cwd apps/example start",
    "android": "bun run --cwd apps/example android",
    "ios": "bun run --cwd apps/example ios",
    "web": "bun run --cwd apps/example web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "prettier --check . && eslint .",
    "typecheck": "bun run typecheck:package && bun run typecheck:example",
    "typecheck:package": "tsc --noEmit -p packages/dial-slider/tsconfig.json",
    "typecheck:example": "tsc --noEmit -p apps/example/tsconfig.json",
    "test": "bun test",
    "build": "bun run --cwd packages/dial-slider build",
    "pack:check": "bun run build && npm pack --dry-run ./packages/dial-slider"
  },
  "devDependencies": {
    "@types/bun": "^1.2.10",
    "browserslist": "^4.28.8",
    "caniuse-lite": "^1.0.30001810",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
