{
  "name": "@ngocdevv/dial-slider",
  "version": "0.1.0",
  "description": "Animated photo-style dial slider component for React Native and Expo.",
  "type": "commonjs",
  "source": "./src/index.ts",
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/src/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/src/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/src/index.d.ts",
        "default": "./lib/commonjs/index.js"
      },
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "BROWSERSLIST_IGNORE_OLD_DATA=1 bob build && bun run fix:esm-declarations",
    "fix:esm-declarations": "bun ./scripts/fix-esm-declarations.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "bun run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "slider",
    "dial",
    "reanimated",
    "gesture-handler",
    "photo-editor",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ngocdevv/dial-slider.git",
    "directory": "packages/dial-slider"
  },
  "bugs": {
    "url": "https://github.com/ngocdevv/dial-slider/issues"
  },
  "homepage": "https://github.com/ngocdevv/dial-slider#readme",
  "author": "Ngoc Le",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "expo-linear-gradient": ">=14.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.81.0 <0.87",
    "react-native-gesture-handler": ">=2.14.0 <3",
    "react-native-reanimated": ">=4.3.0 <4.6",
    "react-native-svg": ">=15.0.0 <16",
    "react-native-worklets": ">=0.8.0 <0.12"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo-linear-gradient": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.40.13",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "tsc": "../../node_modules/.bin/tsc"
        }
      ]
    ]
  }
}
